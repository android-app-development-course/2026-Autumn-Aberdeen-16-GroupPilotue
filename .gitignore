# ── 构建产物 ──────────────────────────────────────────────
**/build/
.gradle/
/captures
.externalNativeBuild/
.cxx/
*.iml

# ── 本机配置（含 SDK 绝对路径，每台机器不同）─────────────
local.properties

# ── IDE 状态（本机窗口/设备/勾选，不入库）────────────────
.idea/

# ── 签名材料：keystore 与口令绝不入库 ────────────────────
/signing/
/dist/*.apk

# ── 模拟器临时目录（含 adbkey 私钥与 adb 日志）───────────
/.adbtmp/
/.emu_home/

# ── 体积较大的素材 / 本机工具 ───────────────────────────
# 截图只在本机留着看，需要时再单独放
/shots/
# PPT 演示与模拟器启动脚本只在本人机器上用，不进仓库
/ppt/
/tools/

# ── 系统杂项 ────────────────────────────────────────────
.DS_Store
Thumbs.db
