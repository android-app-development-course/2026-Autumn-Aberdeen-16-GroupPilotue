<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <!-- ── Masthead ─────────────────────────────────────────────── -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp">

            <LinearLayout
                android:id="@+id/topRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/libraryBack"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="-8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="返回项目库"
                    android:focusable="true"
                    android:padding="7dp"
                    android:src="@drawable/ic_back"
                    android:tint="@color/ink" />

                <TextView
                    android:id="@+id/courseLabel"
                    style="@style/Micro"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="CS4001 · 人机交互" />

                <ImageView
                    android:id="@+id/addItem"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="2dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="新建工作项"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_plus"
                    android:tint="@color/ink" />

                <ImageView
                    android:id="@+id/appSettings"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="设置"
                    android:focusable="true"
                    android:padding="7dp"
                    android:src="@drawable/ic_gear"
                    android:tint="@color/muted" />

                <TextView
                    android:id="@+id/groupLabel"
                    style="@style/Micro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GROUP 16" />
            </LinearLayout>

            <TextView
                android:id="@+id/screenTitle"
                style="@style/Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/topRow"
                android:layout_marginTop="2dp"
                android:text="小组看板"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/planLabel"
                style="@style/Micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@id/screenTitle"
                android:layout_alignParentEnd="true"
                android:layout_marginBottom="3dp"
                android:fontFamily="serif"
                android:letterSpacing="0"
                android:text="计划 v3"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/settingsLink"
                style="@style/Micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/planLabel"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="6dp"
                android:text="项目设置 ›" />
        </RelativeLayout>

        <!-- ── Stage counts ─────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/tickBar"
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:layout_marginTop="18dp"
            android:baselineAligned="false"
            android:orientation="horizontal" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line" />

        <!-- ── Member rail ──────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/memberRail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line" />

        <!-- ── Pending strip ────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/pendingStrip"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/accent_wash"
            android:clickable="true"
            android:focusable="true"
            android:orientation="horizontal"
            android:visibility="gone">

            <View
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:background="@color/accent" />

            <TextView
                android:id="@+id/pendingText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="21dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="待你确认 · 3"
                android:textColor="@color/accent"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/pendingHint"
                style="@style/MicroAccent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="去确认" />

            <ImageView
                android:id="@+id/pendingChevron"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="18dp"
                android:layout_marginStart="4dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron"
                android:tint="@color/accent" />
        </LinearLayout>

        <!-- ── Sections ─────────────────────────────────────────────── -->
        <TextView
            android:id="@+id/filterHint"
            style="@style/MicroAccent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp"
            android:paddingBottom="2dp"
            android:text="筛选 · 待确认　再点一次取消"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/sections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
