<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical">

    <include
        layout="@layout/view_back_bar"
        android:layout_width="match_parent"
        android:layout_height="52dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/kicker"
                style="@style/Micro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="在账本上添一行" />

            <TextView
                android:id="@+id/titleText"
                style="@style/Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="25sp"
                android:text="新建工作项" />

            <TextView
                android:id="@+id/metaText"
                style="@style/Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:background="@color/line" />

            <!-- 标题 -->
            <TextView
                style="@style/Micro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="标题" />

            <EditText
                android:id="@+id/titleField"
                style="@style/Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="例如：补充 2 场用户访谈"
                android:inputType="text"
                android:maxLength="30"
                android:singleLine="true" />

            <!-- 负责人 -->
            <TextView
                style="@style/Micro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="负责人" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/ownerChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- 分值 -->
            <TextView
                style="@style/Micro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="分值" />

            <EditText
                android:id="@+id/pointsField"
                style="@style/Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="5"
                android:inputType="number"
                android:maxLength="3"
                android:singleLine="true" />

            <TextView
                android:id="@+id/pointsHint"
                style="@style/Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <!-- 阶段 -->
            <TextView
                style="@style/Micro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="阶段" />

            <com.example.mycoursepractice.ui.widget.SegmentBar
                android:id="@+id/stageBar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp" />

            <!-- 分摊 -->
            <TextView
                style="@style/Micro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="分摊" />

            <TextView
                style="@style/Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="按百分比写，合计 100；不参与的人填 0" />

            <LinearLayout
                android:id="@+id/shareRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <!-- 交付 -->
            <TextView
                style="@style/Micro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="交付形式" />

            <com.example.mycoursepractice.ui.widget.SegmentBar
                android:id="@+id/formBar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp" />

            <TextView
                style="@style/Micro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="位置与截止" />

            <EditText
                android:id="@+id/placeField"
                style="@style/Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Moodle › 作业区 2"
                android:inputType="text"
                android:singleLine="true" />

            <EditText
                android:id="@+id/dueField"
                style="@style/Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="11-21 23:59"
                android:inputType="text"
                android:singleLine="true" />

            <TextView
                style="@style/Micro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="说明（可选）" />

            <EditText
                android:id="@+id/noteField"
                style="@style/Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="一句话写清怎么算完成"
                android:inputType="textMultiLine"
                android:minHeight="72dp" />

            <TextView
                android:id="@+id/warnText"
                style="@style/MicroOchre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="14dp"
        android:paddingEnd="24dp"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/deleteLink"
            style="@style/MicroOchre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="删除这一项"
            android:visibility="gone" />

        <TextView
            android:id="@+id/cta"
            style="@style/BtnPrimary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="添加到板" />

        <TextView
            android:id="@+id/footerNote"
            style="@style/Micro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="编号自动分配，不回填旧号" />
    </LinearLayout>
</LinearLayout>
